# Deployment Files
# ===============

# Deployment archives
*.zip
library-management-netlify.zip
deployment-package.zip

# Docker files (keep Dockerfile but ignore build artifacts)
docker-compose.override.yml
.dockerignore

# Heroku
.env.production

# Netlify
.netlify/

# Cloud deployment configs (keep templates, ignore actual configs with secrets)
*-production.yml
*-staging.yml
*.production.json
*.staging.json

# Application-Specific
# ===================

# Data files (keep sample data, ignore runtime data)
data/*.txt
data/*.dat
data/runtime/
data/backups/
!data/sample_*

# Configuration files with sensitive information
config/production.properties
config/staging.properties
application-production.properties
application-staging.properties

# Backup files
*.bak
*.backup
*.old

# Test output
test-output/
test-reports/

# Performance and profiling
*.hprof
*.prof

# Security
# ========
# Keep example configs, ignore real ones
**/secrets/
**/*secret*
**/*password*
**/*key*
**/*token*
!**/example-*
!**/sample-*
!**/template-*

# Local configuration override files
local.properties
local-config.json
development.properties

# Documentation build output
docs/_build/
site/

# Cache files
.cache/
*.cache

# Runtime directories
run/
pid/
